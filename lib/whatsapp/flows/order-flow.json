          {
            "type": "Form",
            "name": "checkout_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Your order"
              },
              {
                "type": "TextBody",
                "text": "${data.order_summary_text}"
              },
              {
                "type": "TextSubheading",
                "text": "${data.total_text}"
              },
              {
                "type": "TextInput",
                "name": "customer_name",
                "label": "Your name",
                "input-type": "text",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "customer_phone",
                "label": "Phone number",
                "input-type": "phone",
                "required": true
              },
              {
                "type": "RadioButtonsGroup",
                "name": "fulfillment_type",
                "label": "Pickup or delivery?",
                "required": true,
                "data-source": [
                  {
                    "id": "pickup",
                    "title": "Pickup"
                  },
                  {
                    "id": "delivery",
                    "title": "Delivery"
                  }
                ]
              },
              {
                "type": "TextInput",
                "name": "delivery_address",
                "label": "Delivery address",
                "input-type": "text",
                "required": false,
                "visible": "${form.fulfillment_type} == \"delivery\""
              },
              {
                "type": "Footer",
                "label": "Place Order",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "cart_json": "${data.cart_json}",
                    "customer_name": "${form.customer_name}",
                    "customer_phone": "${form.customer_phone}",
                    "fulfillment_type": "${form.fulfillment_type}",
                    "delivery_address": "${form.delivery_address}"
                  }
                }
              }
            ]
          }
        ]
      }
