# Supabase project: website-builder-africa (ref: vsbklmjeyoiahnfwrgtk, eu-west-1)
NEXT_PUBLIC_SUPABASE_URL=https://vsbklmjeyoiahnfwrgtk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never exposed to the browser, never prefixed with NEXT_PUBLIC_.
# Used only in server-side code paths that must bypass RLS (e.g. admin/service tasks).
SUPABASE_SERVICE_ROLE_KEY=

# Tenant-routing middleware. Your platform's own root domain, e.g.
# websitebuilder.africa — leave blank until you have one; middleware treats
# every host as a platform host (no rewriting) when this is unset.
NEXT_PUBLIC_ROOT_DOMAIN=

# Paynow (exclusive payment aggregator — see locked decision). Requires a
# fixed-IP relay in front of Vercel before production checkout works.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# Google Places API (New) — substituted for Business Profile API, see notes
# in lib/market-fit/google-places.ts.
GOOGLE_PLACES_API_KEY=

# WhatsApp Cloud API — rider dispatch channel. WHATSAPP_WEBHOOK_VERIFY_TOKEN
# is a string you choose yourself and enter in Meta's webhook config; it's
# not issued by Meta. delivery_broadcast template must be approved in Meta
# Business Manager before broadcasts will send.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Shared secret for Vercel Cron routes (forfeit-laybys, escalate-broadcasts,
# refresh-maps-sync). Vercel automatically sends this as a Bearer token when
# invoking scheduled routes if this env var is set.
CRON_SECRET=
