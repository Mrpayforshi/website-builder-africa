# Supabase project: website-builder-africa (ref: vsbklmjeyoiahnfwrgtk, eu-west-1)
NEXT_PUBLIC_SUPABASE_URL=https://vsbklmjeyoiahnfwrgtk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never exposed to the browser, never prefixed with NEXT_PUBLIC_.
# Used only in server-side code paths that must bypass RLS (e.g. admin/service tasks).
SUPABASE_SERVICE_ROLE_KEY=

# Workstream B — AI chat layer
ANTHROPIC_API_KEY=

# Workstream D — Commerce (Paynow is the ONLY payment path; no direct EcoCash API)
# NOTE: Paynow IP-whitelists callers of its interface endpoints. If this app is
# deployed on Vercel (no static outbound IP), route these calls through a
# fixed-IP relay before going live.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# Workstream E — Delivery & Logistics (WhatsApp Cloud API, rider channel only —
# separate from D's outbound-only customer wa.me links)
# NOTE: broadcast messages require an approved Message Template named
# "delivery_broadcast" in Meta Business Manager before they will send.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
